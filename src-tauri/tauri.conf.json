{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickCalc",
  "version": "0.1.0",
  "identifier": "com.ykzstudio.quickcalc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickCalc",
        "width": 720,
        "height": 460,
        "minWidth": 720,
        "minHeight": 460,
        "maxWidth": 720,
        "maxHeight": 460,
        "center": true,
        "visible": false,
        "focus": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A fast, keyboard-first desktop calculator",
    "longDescription": "QuickCalc is a lightweight global-hotkey calculator for Windows, macOS and Linux."
  }
}

